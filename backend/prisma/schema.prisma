// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PHRASAL_VERB
  IDIOM
}

enum WordLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// ---------------------------------------------------------
// AUTH
// ---------------------------------------------------------

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @map("token_hash")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")

  @@index([userId])
}

// ---------------------------------------------------------
// USER
// ---------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  words         Word[]
  refreshTokens RefreshToken[]
  userSentences UserSentence[]
  wordStates    UserWordState[]
}

// ---------------------------------------------------------
// WORD
// ---------------------------------------------------------

model Word {
  id           String       @id @default(cuid())
  word         String
  level        WordLevel?
  partOfSpeech PartOfSpeech @map("part_of_speech")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  meanings      WordMeaning[]
  examples      ExampleSentence[]
  metadata      WordMetadata?
  tags          WordTag[]
  synonyms      Synonym[]
  antonyms      Antonym[]
  relatedWords  RelatedWord[]
  userStates    UserWordState[]
  userSentences UserSentence[]

  @@unique([userId, word, partOfSpeech], name: "user_word_partOfSpeech")
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, level, partOfSpeech])
}

// ---------------------------------------------------------
// WORD MEANING
// ---------------------------------------------------------

model WordMeaning {
  id                String   @id @default(cuid())
  wordId            String   @map("word_id")
  isPrimaryMeaning  Boolean  @default(false) @map("is_primary_meaning")
  meaningOrder      Int      @map("meaning_order")
  englishDefinition String   @map("english_definition")
  nativeMeanings    String   @map("native_meanings") // raw string like "dikkat etmek / fark etmek"
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  word             Word                    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  splittedMeanings SplittedNativeMeaning[]

  @@index([wordId])
}

model SplittedNativeMeaning {
  id          String   @id @default(cuid())
  meaningId   String   @map("meaning_id")
  meaningText String   @map("meaning_text")
  isPrimary   Boolean  @default(false)
  order       Int
  sideNotes   String[] @map("side_notes") // array of strings

  meaning WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  @@index([meaningId])
}

// ---------------------------------------------------------
// EXAMPLE SENTENCES (SYSTEM-PROVIDED)
// ---------------------------------------------------------

model ExampleSentence {
  id               String  @id @default(cuid())
  wordId           String  @map("word_id")
  sentence         String
  translation      String
  clozeDeletedWord Boolean @map("cloze_deleted_word")
  clozePosition    Int?    @map("cloze_position")
  boldIndexes      Int[]   @map("bold_indexes")
  highlightedWord  String  @map("highlighted_word")

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

// ---------------------------------------------------------
// USER-CREATED SENTENCES (PER USER)
// ---------------------------------------------------------

model UserSentence {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  wordId          String  @map("word_id")
  sentence        String
  translation     String
  hideWord        Boolean @default(false) @map("hide_word")
  highlightedWord String  @map("highlighted_word")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wordId])
}

// ---------------------------------------------------------
// WORD METADATA
// ---------------------------------------------------------

model WordMetadata {
  id     String @id @default(cuid())
  wordId String @unique @map("word_id")

  pronunciation String  @map("pronunciation")
  imageUrl      String  @map("image_url")

  // forms
  singularForm        String? @map("singular_form")
  pluralForm          String? @map("plural_form")
  possessiveForm      String? @map("possessive_form")
  regularForms        String[] @map("regular_forms")
  irregularV2         String? @map("irregular_v2")
  irregularV3         String? @map("irregular_v3")
  presentParticiple   String? @map("present_participle")
  thirdPersonSingular String? @map("third_person_singular")
  gerund              String? @map("gerund")
  infinitive          String? @map("infinitive")

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// TAGS (e.g., "B2", "Pre-Intermediate")
// ---------------------------------------------------------

model Tag {
  id   String @id @default(cuid())
  name String @unique

  words WordTag[]
}

model WordTag {
  wordId String
  tagId  String

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([wordId, tagId])
}

// ---------------------------------------------------------
// SYNONYMS / ANTONYMS / RELATED WORDS
// ---------------------------------------------------------

model Synonym {
  id     String @id @default(cuid())
  wordId String @map("word_id")
  text   String

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Antonym {
  id     String @id @default(cuid())
  wordId String @map("word_id")
  text   String

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model RelatedWord {
  id     String @id @default(cuid())
  wordId String @map("word_id")
  text   String

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// USER-WORD STATE (star, keepLearning, etc.)
// ---------------------------------------------------------

model UserWordState {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  wordId       String  @map("word_id")
  isStarred      Boolean @default(false) @map("is_starred")
  keepLearning Boolean @default(false) @map("keep_learning")

  correctCount Int @default(0) @map("correct_count")
  wrongCount Int @default(0) @map("wrong_count")
  practiceCount Int @default(0) @map("practice_count")
  streakCount Int @default(0) @map("streak_count")
  repetition Int @default(0) 
  interval Int @default(0)
  easeFactor Decimal @default(2.5) @map("ease_factor")

  firstReviewAt DateTime? @map("first_review_at")
  lastReviewedAt DateTime? @map("last_review_at")
  nextReviewAt DateTime? @map("next_review_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, wordId])
  @@index([userId, isStarred])
  @@index([userId, keepLearning])
  @@index([userId, nextReviewAt])
}
