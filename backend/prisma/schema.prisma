// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PHRASAL_VERB
  IDIOM
  EXPRESSION
}

enum WordLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// ---------------------------------------------------------
// AUTH
// ---------------------------------------------------------

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")

  @@index([userId])
}

// ---------------------------------------------------------
// USER
// ---------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  words            Word[]
  refreshTokens    RefreshToken[]
  meaningStates    UserMeaningState[]
  exerciseSessions ExerciseSession[]
  folders          Folder[]
  wordLists        WordList[]
  presets          ExerciseSettingsPreset[]
}

// ---------------------------------------------------------
// WORD (Lexeme Level)
// ---------------------------------------------------------

model Word {
  id             String       @id @default(cuid())
  word           String
  level          WordLevel?
  partOfSpeech   PartOfSpeech @map("part_of_speech")
  pronunciation  String?
  wordFamily     String?      @map("word_family")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meanings  WordMeaning[]
  listItems WordListItem[]

  @@unique([userId, word, partOfSpeech])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, level, partOfSpeech])
}

// ---------------------------------------------------------
// WORD MEANING (Sense Level)
// ---------------------------------------------------------

model WordMeaning {
  id                String   @id @default(cuid())
  wordId            String   @map("word_id")
  word              Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  meaningOrder      Int      @map("meaning_order")
  englishDefinition String?  @map("english_definition")
  nativeMeanings    String   @map("native_meanings")
  createdAt DateTime @default(now()) @map("created_at")

  examples               ExampleSentence[]
  tags                   WordMeaningTag[]
  userStates             UserMeaningState[]
  splittedNativeMeanings SplittedNativeMeaning[]
  sessionQuestions       SessionQuestion[]

  @@unique([wordId, meaningOrder])
  @@index([wordId])
}

// ---------------------------------------------------------
// SPLITTED NATIVE MEANINGS
// ---------------------------------------------------------

model SplittedNativeMeaning {
  id          String   @id @default(cuid())
  meaningId   String   @map("meaning_id")
  meaning     WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  meaningText String   @map("meaning_text")
  order       Int

  @@index([meaningId])
}

// ---------------------------------------------------------
// EXAMPLE SENTENCES (Meaning Level)
// ---------------------------------------------------------

model ExampleSentence {
  id          String  @id @default(cuid())
  meaningId   String  @map("meaning_id")
  meaning     WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  sentence     String?
  translation  String?
  clozeTemplate String?
  answers       String[]

  // Turkish translation cloze (mirror of clozeTemplate/answers for native side).
  translationTemplate String?  @map("translation_template")
  translationAnswers  String[] @map("translation_answers")

  @@index([meaningId])
}

// ---------------------------------------------------------
// TAGS (Global Tag Dictionary)
// ---------------------------------------------------------

model Tag {
  id   String @id @default(cuid())
  name String @unique

  meanings WordMeaningTag[]
}

// ---------------------------------------------------------
// WORD MEANING TAG (Join Table)
// ---------------------------------------------------------

model WordMeaningTag {
  meaningId String
  tagId     String

  meaning WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([meaningId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------
// EXERCISE SESSION
// ---------------------------------------------------------

enum ExerciseType {
  FLASH_CARD
  MULTIPLE_CHOICE
  WRITING
  TRUE_FALSE
  MATCHING
  FIND_IN_SENTENCE
}

enum LanguageSetting {
  ENGLISH_NATIVE
  ENGLISH_ENGLISH
}

// Content facet used as the question prompt or the answer/option in an exercise.
enum ContentFormat {
  ENGLISH_WORD
  ENGLISH_DEFINITION
  ENGLISH_SENTENCE
  ENGLISH_SENTENCE_CLOZE
  ENGLISH_SENTENCE_HIGHLIGHTED
  NATIVE_MEANING
  NATIVE_SENTENCE
  NATIVE_SENTENCE_HIGHLIGHTED
  WORD_FAMILY
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ExerciseSession {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseType    ExerciseType    @map("exercise_type")
  languageSetting LanguageSetting @map("language_setting")
  status          SessionStatus   @default(IN_PROGRESS)

  totalQuestions  Int             @map("total_questions")
  answeredCount   Int             @default(0) @map("answered_count")
  correctCount    Int             @default(0) @map("correct_count")
  wrongCount      Int             @default(0) @map("wrong_count")

  startedAt       DateTime        @default(now()) @map("started_at")
  completedAt     DateTime?       @map("completed_at")

  questions       SessionQuestion[]

  @@index([userId])
  @@index([userId, status])
  @@map("exercise_sessions")
}

model SessionQuestion {
  id            String          @id @default(cuid())
  sessionId     String          @map("session_id")
  session       ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  meaningId     String          @map("meaning_id")
  meaning       WordMeaning     @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  questionOrder Int             @map("question_order")
  questionText  String          @map("question_text")
  correctAnswer String          @map("correct_answer")
  options       String[]

  prompt        String?

  // Lowercase part-of-speech label (e.g. "phrasal verb"), shown separately.
  partOfSpeech  String?         @map("part_of_speech")

  // Multi-part faces for Flash Cards: arrays of { format, text }.
  front         Json?
  back          Json?

  isAnswered    Boolean         @default(false) @map("is_answered")
  isCorrect     Boolean?        @map("is_correct")
  userAnswer    String?         @map("user_answer")
  answeredAt    DateTime?       @map("answered_at")

  @@unique([sessionId, questionOrder])
  @@index([sessionId])
  @@map("session_questions")
}

// ---------------------------------------------------------
// USER MEANING STATE (Spaced Repetition Per Meaning)
// ---------------------------------------------------------

model UserMeaningState {
  id        String @id @default(cuid())

  userId    String @map("user_id")
  meaningId String @map("meaning_id")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meaning  WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  isStarred    Boolean @default(false) @map("is_starred")
  keepLearning Boolean @default(true)  @map("keep_learning")

  correctCount   Int @default(0) @map("correct_count")
  wrongCount     Int @default(0) @map("wrong_count")
  practiceCount  Int @default(0) @map("practice_count")
  streakCount    Int @default(0) @map("streak_count")

  repetition Int @default(0)
  interval   Int @default(0)

  easeFactor Decimal @default(2.5) @db.Decimal(4,2) @map("ease_factor")

  firstReviewAt  DateTime? @map("first_review_at")
  lastReviewedAt DateTime? @map("last_review_at")
  nextReviewAt   DateTime? @map("next_review_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, meaningId])
  @@index([userId])
  @@index([userId, isStarred])
  @@index([userId, keepLearning])
  @@index([userId, nextReviewAt])
}

// ---------------------------------------------------------
// FOLDER & WORD LIST
// ---------------------------------------------------------

model Folder {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wordLists WordList[]

  @@unique([userId, name])
  @@index([userId])
  @@map("folders")
}

model WordList {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId String? @map("folder_id")
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items WordListItem[]

  @@unique([userId, name])
  @@index([userId])
  @@index([folderId])
  @@map("word_lists")
}

model WordListItem {
  wordListId String   @map("word_list_id")
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)

  wordId String @map("word_id")
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([wordListId, wordId])
  @@index([wordId])
  @@map("word_list_items")
}

// ---------------------------------------------------------
// EXERCISE SETTINGS PRESET
// ---------------------------------------------------------

model ExerciseSettingsPreset {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  exerciseType    ExerciseType    @map("exercise_type")
  languageSetting LanguageSetting @map("language_setting")

  questionCount   Int @default(10) @map("question_count")
  numberOfOptions Int @default(4)  @map("number_of_options")

  questionFormat ContentFormat? @map("question_format")
  answerFormat   ContentFormat? @map("answer_format")
  exampleOrder   Int?           @map("example_order")

  // Multi-part Flash Card faces (ordered content formats per side).
  frontFormats   ContentFormat[] @map("front_formats")
  backFormats    ContentFormat[] @map("back_formats")

  folderIds        String[]       @map("folder_ids")
  wordListIds      String[]       @map("word_list_ids")
  levels           WordLevel[]
  partsOfSpeech    PartOfSpeech[] @map("parts_of_speech")
  onlyStarred      Boolean        @default(false) @map("only_starred")
  onlyKeepLearning Boolean        @default(false) @map("only_keep_learning")
  excludeLearned   Boolean        @default(true)  @map("exclude_learned")
  tagIds           String[]       @map("tag_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("exercise_settings_presets")
}