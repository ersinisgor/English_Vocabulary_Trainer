// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PHRASAL_VERB
  IDIOM
  EXPRESSION
}

enum WordLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// ---------------------------------------------------------
// AUTH
// ---------------------------------------------------------

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")

  @@index([userId])
}

// ---------------------------------------------------------
// USER
// ---------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  words          Word[]
  refreshTokens  RefreshToken[]
  meaningStates  UserMeaningState[]
}

// ---------------------------------------------------------
// WORD (Lexeme Level)
// ---------------------------------------------------------

model Word {
  id             String       @id @default(cuid())
  word           String
  level          WordLevel?
  partOfSpeech   PartOfSpeech @map("part_of_speech")
  pronunciation  String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meanings WordMeaning[]

  @@unique([userId, word, partOfSpeech])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, level, partOfSpeech])
}

// ---------------------------------------------------------
// WORD MEANING (Sense Level)
// ---------------------------------------------------------

model WordMeaning {
  id                String   @id @default(cuid())
  wordId            String   @map("word_id")
  word              Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  meaningOrder      Int      @map("meaning_order")
  englishDefinition String?  @map("english_definition")
  nativeMeanings    String   @map("native_meanings")
  createdAt DateTime @default(now()) @map("created_at")

  examples     ExampleSentence[]
  tags         WordMeaningTag[]
  userStates   UserMeaningState[]
  splittedNativeMeanings SplittedNativeMeaning[]

  @@unique([wordId, meaningOrder])
  @@index([wordId])
}

// ---------------------------------------------------------
// SPLITTED NATIVE MEANINGS
// ---------------------------------------------------------

model SplittedNativeMeaning {
  id          String   @id @default(cuid())
  meaningId   String   @map("meaning_id")
  meaning     WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  meaningText String   @map("meaning_text")
  order       Int

  @@index([meaningId])
}

// ---------------------------------------------------------
// EXAMPLE SENTENCES (Meaning Level)
// ---------------------------------------------------------

model ExampleSentence {
  id          String  @id @default(cuid())
  meaningId   String  @map("meaning_id")
  meaning     WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  sentence     String?
  translation  String?
  clozeTemplate String?
  answers       String[]

  @@index([meaningId])
}

// ---------------------------------------------------------
// TAGS (Global Tag Dictionary)
// ---------------------------------------------------------

model Tag {
  id   String @id @default(cuid())
  name String @unique

  meanings WordMeaningTag[]
}

// ---------------------------------------------------------
// WORD MEANING TAG (Join Table)
// ---------------------------------------------------------

model WordMeaningTag {
  meaningId String
  tagId     String

  meaning WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([meaningId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------
// USER MEANING STATE (Spaced Repetition Per Meaning)
// ---------------------------------------------------------

model UserMeaningState {
  id        String @id @default(cuid())

  userId    String @map("user_id")
  meaningId String @map("meaning_id")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meaning  WordMeaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  isStarred    Boolean @default(false) @map("is_starred")
  keepLearning Boolean @default(true)  @map("keep_learning")

  correctCount   Int @default(0) @map("correct_count")
  wrongCount     Int @default(0) @map("wrong_count")
  practiceCount  Int @default(0) @map("practice_count")
  streakCount    Int @default(0) @map("streak_count")

  repetition Int @default(0)
  interval   Int @default(0)

  easeFactor Decimal @default(2.5) @db.Decimal(4,2) @map("ease_factor")

  firstReviewAt  DateTime? @map("first_review_at")
  lastReviewedAt DateTime? @map("last_review_at")
  nextReviewAt   DateTime? @map("next_review_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, meaningId])
  @@index([userId])
  @@index([userId, isStarred])
  @@index([userId, keepLearning])
  @@index([userId, nextReviewAt])
}